EXCHANGE 5
    X 0.06064 	# mol X/L bulk; calculated with density: 2.65 kg/l solid phase, average porosity: 0.379572832; CEC: 14 meq/kg DS=0.014 mol X/kg DS; X = CEC * density/(1000*porosity)
    -equilibrate 1
END

SELECTED_OUTPUT 1
        -file            advect.sel
        -reset           false
USER_PUNCH 1
-heading  CELL_NO TIME pH Cl Ca Na K Tds
-start
  10 PUNCH CELL_NO TOTAL_TIME
  20 PUNCH -LA("H+") # pH
  30 PUNCH tot("Cl")
  40 PUNCH tot("Ca")
  50 PUNCH tot("Na")
  60 PUNCH tot("K")
  70 PUNCH tot("Tds")

-end
