# File written with iMOD Python version: 1.1.0

begin options
  print_option SUMMARY
  ats_outer_maximum_fraction 0.3
end options

begin nonlinear
  outer_dvclose 0.1
  outer_maximum 100
  under_relaxation dbd
  under_relaxation_theta 0.8
  under_relaxation_kappa 0.0001
  under_relaxation_gamma 0.0
  under_relaxation_momentum 0.0
  backtracking_number 20
  backtracking_tolerance 1.05
  backtracking_reduction_factor 0.1
  backtracking_residual_limit 0.002
end nonlinear

begin linear
  inner_maximum 500
  inner_dvclose 0.1
  inner_rclose 0.1 strict
  linear_acceleration bicgstab
  relaxation_factor 0.0
  preconditioner_levels 5
  preconditioner_drop_tolerance 0.0001
  number_orthogonalizations 2
end linear
